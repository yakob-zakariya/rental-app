<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG BUILDS ONLY. Lets the app call the local rental-api over plain HTTP on
     localhost: the phone is connected by USB and `adb reverse tcp:3000 tcp:3000` forwards
     the phone's localhost:3000 to the computer. Everything else (including ngrok tunnels)
     must use HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>

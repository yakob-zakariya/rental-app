<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark mode on. Android 11 and older: the window while the app starts. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Removed automatically when Flutter draws its first frame. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- The window colour behind Flutter while it initializes and runs: the
         same background, so there's no flash between launch and first frame. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
